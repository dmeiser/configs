# Copy this to .env and fill values

# Timezone (you said "New York")
TZ=America/New_York
GENERIC_TIMEZONE=America/New_York

# Public hostname that Cloudflare will expose for n8n (no trailing slash)
PUBLIC_HOST=example.yourdomain.com

# n8n encryption key (required) - generate a strong random string (>=32 chars)
N8N_ENCRYPTION_KEY=replace_with_a_strong_random_value

# Cloudflared token (from Cloudflare Zero Trust -> Tunnels)
CLOUDFLARED_TOKEN=replace_with_cloudflared_token

# Secrets (now plain env vars)
NEXTDNS_API_KEY=your_nextdns_api_key_value
NEXTDNS_PROFILE_ID=your_nextdns_profile_id_value
SLACK_BOT_TOKEN=your_slack_bot_token_value
SLACK_SIGNING_SECRET=your_slack_signing_secret_value

# Optional Basic Auth for n8n (recommended if publicly reachable)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=strongpassword
