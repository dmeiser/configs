# Timezone
TZ=America/New_York
GENERIC_TIMEZONE=America/New_York

# Public hostname
PUBLIC_HOST=example.yourdomain.com

# n8n encryption key (required)
N8N_ENCRYPTION_KEY=replace_with_a_strong_random_value

# Cloudflared token
CLOUDFLARED_TOKEN=replace_with_cloudflared_token

# Plain env secrets
NEXTDNS_API_KEY=your_nextdns_api_key_value
NEXTDNS_PROFILE_ID=your_nextdns_profile_id_value
SLACK_BOT_TOKEN=your_slack_bot_token_value
SLACK_SIGNING_SECRET=your_slack_signing_secret_value

# Service account UID/GID to run the container as (optional).
# Set these so files created inside the bind-mounts are owned by your host service account.
# Defaults to 1000:1000 (node user in the n8n image). Example for a system service account with UID 1001:
SERVICE_UID=1001
SERVICE_GID=1001
