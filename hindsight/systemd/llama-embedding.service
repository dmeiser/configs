[Unit]
Description=Llama Embedding Local Server (Vulkan)
After=network.target

[Service]
Type=simple

Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus"
Environment="XDG_SESSION_TYPE=tty"
Environment="XDG_SESSION_CLASS=user"
Environment="XDG_RUNTIME_DIR=/run/user/%U"

ExecStart=/home/username/.local/bin/llama serve -hf argus-ai/pplx-embed-context-v1-0.6b-GGUF:Q8_0 --host 0.0.0.0 --port 8081 -ngl 99999 --embedding --device CUDA1 --batch-size 4096 --ubatch-size 4096 --ctx-size 4096 
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
