[Unit]
Description=Llama Reranking Local Server (Vulkan)
After=network.target

[Service]
Type=simple

Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus"
Environment="XDG_SESSION_TYPE=tty"
Environment="XDG_SESSION_CLASS=user"
Environment="XDG_RUNTIME_DIR=/run/user/%U"

# ExecStart=/home/username/.local/bin/llama serve -m /home/username/.local/share/gguf/bge-reranker-v2-m3-q8_0.gguf --host 0.0.0.0 --port 8080 -ngl 99999 --rerank --device Vulkan1
ExecStart=/home/username/.local/bin/llama serve -hf ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF --host 0.0.0.0 --port 8080 -ngl 99999 --rerank --device CUDA0 --ctx-size 16384 --batch-size 1024 --ubatch-size 1024
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
